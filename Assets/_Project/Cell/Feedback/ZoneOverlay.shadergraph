    "m_Slots": [
        {
            "m_Id": "d1b1c683c9894e34b7a878c9826fdd48"
        },
        {
            "m_Id": "4f0b2e693c3741d6bcd4e5444933c59f"
        },
        {
            "m_Id": "036b886d68f447a9acac46b42a700dc2"
        },
        {
            "m_Id": "811eaadd28754aaeaa74a04d5b2bf0c4"
        },
        {
            "m_Id": "e1ac634bf081471db201adbcaf2b654b"
        },
        {
            "m_Id": "0973e593d7564d64a82f10c0d75a31d2"
        },
        {
            "m_Id": "b320e8f33f044cf19b3d753e0c5f37f9"
        },
        {
            "m_Id": "55c06a1a7d0649deb260a1fa7defd319"
        },
        {
            "m_Id": "6e80418867374747b553ebf3b60adcbd"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ComputeZone",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 pixelPos = ScreenPos.xy; \r\n\nfloat2 screenSize = _ScreenParams.xy;\r\nfloat2 texel = 1.0 / screenSize;\n\r\nfloat2 uvCenter = pixelPos * texel;\r\nfloat2 uvRight  = (pixelPos + float2( 1.0,  0.0)) * texel;\r\nfloat2 uvLeft   = (pixelPos + float2(-1.0,  0.0)) * texel;\r\nfloat2 uvUp     = (pixelPos + float2( 0.0,  1.0)) * texel;\r\nfloat2 uvDown   = (pixelPos + float2( 0.0, -1.0)) * texel;\r\n\r\nfloat maskCenter = ZoneTex.Sample(ZoneTexSampler, uvCenter).r;\r\nfloat maskRight  = ZoneTex.Sample(ZoneTexSampler, uvRight ).r;\r\nfloat maskLeft   = ZoneTex.Sample(ZoneTexSampler, uvLeft  ).r;\r\nfloat maskUp     = ZoneTex.Sample(ZoneTexSampler, uvUp    ).r;\r\nfloat maskDown   = ZoneTex.Sample(ZoneTexSampler, uvDown  ).r;\r\n\r\nfloat fillMask = step(FillThreshold, maskCenter);\r\n\nfloat diffRight = abs(maskRight - maskCenter);\r\nfloat diffLeft  = abs(maskLeft  - maskCenter);\r\nfloat diffUp    = abs(maskUp    - maskCenter);\r\nfloat diffDown  = abs(maskDown  - maskCenter);\r\n\nfloat edgeRaw1 = max(diffRight, diffLeft);\r\nfloat edgeRaw2 = max(diffUp,    diffDown);\r\nfloat edgeRaw  = max(edgeRaw1,  edgeRaw2);\r\n\nfloat edgeMask = step(EdgeThreshold, edgeRaw);\r\n\r\nfloat4 fillCol   = FillColor   * fillMask;\r\nfloat4 borderCol = BorderColor * edgeMask;\r\n\nfloat4 finalCol = fillCol + borderCol;\r\nfloat alpha = saturate(fillMask + edgeMask);\r\n\nOutColor = finalCol;\r\nOutAlpha = alpha;\n"
}

