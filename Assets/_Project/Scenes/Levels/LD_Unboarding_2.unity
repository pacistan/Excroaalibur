    m_Modifications:
    - target: {fileID: 134540935242368777, guid: 8ceb726ec6d92264eaf5e690f9c19af8, type: 3}
      propertyPath: m_text
      value: "If you kill an enemy with the Sword, it will get back to the thrower
        instantly, but if it doesn\u2019t, it will bounce just in front of them.\n\r\nEach
        time you pass the Sword between your characters, it will grow in power by
        1, allowing you to kill stronger enemies. \n\nIts power resets after a kill
        or after it\u2019s thrown but not passed."
      objectReference: {fileID: 0}
